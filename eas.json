{
  "cli": {
    "version": "16.4.1",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "scervmvp-dev"
      }
    },
    "testing": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "testing",
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "scervmvp-testing"
      }
    },
    "preview": {
      "extends": "testing"
    },
    "storeTesting": {
      "env": {
        "APP_ENV": "storeTesting",
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "scervmvp-dev"
      },
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      }
    },
    "production": {
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "scervmvp"
      },
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./eas-submit-key.json"
      },
      "ios": {
        "ascAppId": "1591335061"
      }
    },
    "storeTesting": {
      "android": {
        "serviceAccountKeyPath": "./eas-submit-key.json",
        "track": "internal"
      },
      "ios": {
        "ascAppId": "1591335061"
      }
    }
  }
}
