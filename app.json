{
  "expo": {
    "name": "Scerv",
    "slug": "scerv",
    "version": "0.0.41",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "scheme": "scerv",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.scerv.app",
      "newArchEnabled": false,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to allow you to upload profile pictures or add photos of menu items.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "31"
    },
    "android": {
      "versionCode": 33,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.scerv.eat",
      "newArchEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8f9fa",
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "imageWidth": 512,
          "android": {
            "backgroundColor": "#f8f9fa",
            "image": "./assets/splash.png",
            "resizeMode": "contain",
            "imageWidth": 260
          },
          "ios": {
            "backgroundColor": "#f8f9fa",
            "image": "./assets/splash.png",
            "resizeMode": "cover",
            "imageWidth": 512
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "kotlinVersion": "2.0.21"
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "@stripe/stripe-terminal-react-native",
        {
          "bluetoothAlwaysUsagePermission": "Allow Scerv to connect to Stripe card readers.",
          "bluetoothPeripheralPermission": "Allow Scerv to connect to Stripe card readers.",
          "localNetworkUsagePermission": "Allow Scerv to find Stripe readers on this network.",
          "locationWhenInUsePermission": "Allow Scerv to discover nearby Stripe card readers."
        }
      ],
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Scerv to access your camera to scan table QR codes."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "8f4dca40-c2fa-4381-98c5-57de335fef12"
      }
    }
  }
}
