{
  "expo": {
    "name": "Scerv",
    "slug": "scerv",
    "version": "0.0.25",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "scheme": "scerv",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scerv.app",
      "newArchEnabled": false,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to allow you to upload profile pictures or add photos of menu items.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "14"
    },
    "android": {
      "versionCode": 14,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.scerv.eat",
      "newArchEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8f9fa",
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "imageWidth": 512,
          "imageHeight": 512
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-audio",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "8f4dca40-c2fa-4381-98c5-57de335fef12"
      }
    }
  }
}
