rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function role() {
      return signedIn() && request.auth.token.role is string
        ? request.auth.token.role
        : "";
    }

    function tokenRestaurantId() {
      return signedIn() && request.auth.token.restaurantId is string
        ? request.auth.token.restaurantId
        : "";
    }

    function isOwner(userId) {
      return signedIn() && uid() == userId;
    }

    function isRestaurantUser(restaurantId) {
      return signedIn() &&
        (uid() == restaurantId || tokenRestaurantId() == restaurantId);
    }

    function isRestaurantManager(restaurantId) {
      return isRestaurantUser(restaurantId) &&
        role() in ["owner", "manager", "restaurant"];
    }

    function isPartyReader(data) {
      return signedIn() && (
        isRestaurantUser(data.restaurantId) ||
        uid() == data.hostUserId ||
        uid() in data.guestUserIds ||
        uid() in data.memberUids
      );
    }

    function partyExists(partyId) {
      return exists(/databases/$(database)/documents/parties/$(partyId));
    }

    function isPartyReaderById(partyId) {
      return partyExists(partyId) &&
        isPartyReader(get(/databases/$(database)/documents/parties/$(partyId)).data);
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(keys) &&
        request.resource.data.diff(resource.data).addedKeys().hasOnly(keys) &&
        request.resource.data.diff(resource.data).removedKeys().hasOnly([]);
    }

    function isCustomerServiceRequestUpdate() {
      return signedIn() &&
        isPartyReader(resource.data) &&
        changedOnly([
          "customerStatus",
          "checkoutRequestedAt",
          "fulfillmentType",
          "pickupSpecialInstructions",
          "serviceRequested",
          "serviceRequestType",
          "serviceRequestStatus",
          "serviceRequestedAt",
          "serviceTableName"
        ]);
    }

    function isValidPublicLeadRequest() {
      return request.resource.data.keys().hasOnly([
          "name",
          "restaurantName",
          "email",
          "phone",
          "message",
          "timestamp"
        ]) &&
        request.resource.data.keys().hasAll([
          "name",
          "restaurantName",
          "email",
          "phone",
          "timestamp"
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 1 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.restaurantName is string &&
        request.resource.data.restaurantName.size() >= 1 &&
        request.resource.data.restaurantName.size() <= 160 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 3 &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 8 &&
        request.resource.data.phone.size() <= 30 &&
        (!("message" in request.resource.data) ||
          (request.resource.data.message is string &&
            request.resource.data.message.size() <= 2000)) &&
        request.resource.data.timestamp == request.time;
    }

    function isOwnBasketItem(data) {
      return signedIn() && data.userId == uid();
    }

    function isRestaurantMenuOwner(data) {
      return data.restaurantId is string && isRestaurantUser(data.restaurantId);
    }

    function isPendingOrderOwner(data) {
      return signedIn() && data.customerId == uid();
    }

    function isOwnCheckInRequest(data) {
      return signedIn() &&
        data.customerId == uid() &&
        data.restaurantId is string &&
        data.status == "REQUESTED";
    }

    match /customers/{userId} {
      allow create: if isOwner(userId);
      allow read: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      match /pips/{pipId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /savedPaymentMethods/{paymentMethodId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /baskets/{basketId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create, update: if isRestaurantManager(restaurantId);
      allow delete: if false;

      match /tables/{tableId} {
        allow read: if true;
        allow create, update, delete: if isRestaurantManager(restaurantId);
      }

      match /employees/{employeeId} {
        allow read: if isRestaurantUser(restaurantId);
        allow write: if false;
      }

      match /work_days/{workDayId} {
        allow read: if isRestaurantUser(restaurantId);
        allow write: if false;
      }

      match /payment_events/{eventId} {
        allow read: if isRestaurantManager(restaurantId);
        allow write: if false;
      }

      match /{document=**} {
        allow read: if isRestaurantUser(restaurantId);
        allow write: if false;
      }
    }

    match /menuItems/{itemId} {
      allow read: if true;
      allow create: if signedIn() &&
        isRestaurantMenuOwner(request.resource.data) &&
        isRestaurantManager(request.resource.data.restaurantId);
      allow update: if signedIn() &&
        isRestaurantMenuOwner(resource.data) &&
        isRestaurantManager(resource.data.restaurantId) &&
        request.resource.data.restaurantId == resource.data.restaurantId;
      allow delete: if signedIn() &&
        isRestaurantMenuOwner(resource.data) &&
        isRestaurantManager(resource.data.restaurantId);

      match /ratings/{ratingId} {
        allow read: if true;
        allow create: if signedIn() &&
          request.resource.data.userId == uid();
        allow update, delete: if false;
      }
    }

    match /baskets/{basketId} {
      allow read: if isOwnBasketItem(resource.data) ||
        isRestaurantUser(resource.data.restaurantId);
      allow create, update, delete: if false;
    }

    match /shared_baskets/{partyId} {
      allow read: if isPartyReaderById(partyId);
      allow create, update, delete: if false;
    }

    match /parties/{partyId} {
      allow read: if isPartyReader(resource.data);
      allow create, delete: if false;
      allow update: if isCustomerServiceRequestUpdate();
    }

    match /checkIns/{checkInId} {
      allow read: if signedIn() && (
        uid() == resource.data.userId ||
        uid() == resource.data.customerId ||
        isRestaurantUser(resource.data.restaurantId)
      );
      allow create: if isOwnCheckInRequest(request.resource.data);
      allow update, delete: if false;
    }

    match /kitchen_orders/{orderId} {
      allow read: if isRestaurantUser(resource.data.restaurantId) ||
        (resource.data.customerId is string && uid() == resource.data.customerId);

      allow create, update, delete: if false;
    }

    match /orders/{orderId} {
      allow read: if signedIn() && (
        uid() == resource.data.customerId ||
        uid() == resource.data.userId ||
        isRestaurantUser(resource.data.restaurantId)
      );

      allow create, update, delete: if false;
    }

    match /pending_orders/{orderId} {
      allow read: if isPendingOrderOwner(resource.data) ||
        isRestaurantUser(resource.data.restaurantId);

      // Legacy checkout creates pending_orders before calling payment functions.
      // Payment functions must continue recalculating totals server-side.
      allow create: if isPendingOrderOwner(request.resource.data);
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (
        uid() == resource.data.userId ||
        uid() == resource.data.customerId ||
        uid() == resource.data.recipientId ||
        uid() == resource.data.recipientUserId
      );
      allow update: if signedIn() &&
        (uid() == resource.data.userId ||
          uid() == resource.data.customerId ||
          uid() == resource.data.recipientId ||
          uid() == resource.data.recipientUserId) &&
        changedOnly(["isRead"]);
      allow create, delete: if false;
    }

    match /dishRatings/{ratingId} {
      allow read: if true;
      allow create: if signedIn() &&
        request.resource.data.userId == uid();
      allow update, delete: if false;
    }

    match /dishes/{dishId} {
      allow read: if true;
      allow write: if false;
    }

    match /appConfig/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /demoRequests/{requestId} {
      allow create: if isValidPublicLeadRequest();
      allow read, update, delete: if false;
    }

    match /contacts/{contactId} {
      allow create: if isValidPublicLeadRequest();
      allow read, update, delete: if false;
    }

    match /admins/{adminId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
